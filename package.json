{
  "name": "nexsift",
  "private": true,
  "packageManager": "yarn@4.9.2",
  "workspaces": [
    "web",
    "lambda"
  ],
  "scripts": {
    "dev": "yarn workspace @nexsift/web dev",
    "build": "yarn workspace @nexsift/lambda build && yarn workspace @nexsift/web build",
    "lint": "yarn workspace @nexsift/web lint",
    "typecheck": "yarn workspace @nexsift/lambda typecheck && yarn workspace @nexsift/web typecheck",
    "test": "yarn workspace @nexsift/lambda test",
    "infra:up": "docker compose -f iac/local/compose.yml up -d",
    "infra:down": "docker compose -f iac/local/compose.yml down",
    "infra:logs": "docker compose -f iac/local/compose.yml logs -f ministack",
    "lambda:build": "yarn workspace @nexsift/lambda build",
    "terraform:init": "terraform -chdir=iac/terraform init",
    "terraform:local:plan": "terraform -chdir=iac/terraform plan -var-file=local.tfvars",
    "terraform:local:apply": "terraform -chdir=iac/terraform apply -auto-approve -var-file=local.tfvars",
    "terraform:local:destroy": "terraform -chdir=iac/terraform destroy -auto-approve -var-file=local.tfvars"
  },
  "dependencies": {
    "tsx": "4.23.1"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
