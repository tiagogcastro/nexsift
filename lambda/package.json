{
  "name": "@nexsift/lambda",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "mkdir -p dist/publish && esbuild src/publish/handler.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/publish/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1097.0",
    "@aws-sdk/client-ssm": "3.1094.0",
    "@nexsift/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.162",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
